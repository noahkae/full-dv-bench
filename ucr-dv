#!/usr/bin/env bash
# UCR driverless workbench launcher.
#   ./ucr-dv                      the GUI
#   ./ucr-dv run --track autocross --seeds 0 1 2     headless (see python -m ucr_dv --help)
# First run creates .venv (uv if available, else python3 -m venv) from requirements.txt.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$HERE/.venv"
PY="$VENV/bin/python"
if [ ! -x "$PY" ]; then
    echo "[ucr-dv] creating $VENV ..."
    if command -v uv >/dev/null 2>&1; then
        uv venv -q "$VENV"
        uv pip install -q --python "$PY" -r "$HERE/requirements.txt"
    else
        python3 -m venv "$VENV"
        "$PY" -m pip install -q -r "$HERE/requirements.txt"
    fi
    touch "$VENV/.stamp"
elif [ "$HERE/requirements.txt" -nt "$VENV/.stamp" ]; then
    echo "[ucr-dv] requirements changed, updating ..."
    if command -v uv >/dev/null 2>&1; then uv pip install -q --python "$PY" -r "$HERE/requirements.txt"
    else "$PY" -m pip install -q -r "$HERE/requirements.txt"; fi
    touch "$VENV/.stamp"
fi
export PYTHONUNBUFFERED=1
cd "$HERE"
exec "$PY" -m ucr_dv "$@"
